# --- Growth Snapshot (audit tool) ---
# Postgres connection string (Neon/Vercel Postgres in production; a free Neon dev branch works locally)
DATABASE_URL=
# Gemini API key (server-side only) — powers the analysis pipeline
GEMINI_API_KEY=
# Resend API key for report delivery + nurture emails; leave empty in dev (emails are logged, not sent)
RESEND_API_KEY=
EMAIL_FROM="Catalyst Solutions Services <reports@catalystsolutionservices.com>"
# Absolute site URL used in email links
SITE_URL=http://localhost:3000
# Admin portal accounts: "email:password,email:password" (full access each)
ADMIN_ACCOUNTS=
# Random secret for signing admin session cookies
ADMIN_SESSION_SECRET=
# Bearer secret for GET /api/cron/nurture (hit daily by your scheduler)
CRON_SECRET=

# --- Existing site ---
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Optional: override the Gemini model (free tier: flash ~20 req/day, flash-lite has a larger quota)
GEMINI_MODEL=

# Stripe (Book Now — 50% onboarding deposit checkout); sk_live_... in production
STRIPE_SECRET_KEY=


# --- CatalystGrowthOS v2 (names only; see GROWTHOS_EXTERNAL_SETUP.md) ---
# Field-encryption key. REQUIRED — there is no fallback. LEADOS_LEGACY_SECRET only while rotating old ciphertext.
LEADOS_SECRET=
LEADOS_LEGACY_SECRET=
# Local development and tests must use a LOCAL database:
#   .env.development.local → DATABASE_URL=postgresql://growthos@localhost:54329/growthos_dev
#   .env.test.local        → TEST_DATABASE_URL=postgresql://growthos@localhost:54329/growthos_test
TEST_DATABASE_URL=
# Managed model: public sign-up / org creation is closed unless "on"
GROWTHOS_SELF_SERVICE=off
# Text AI (OpenAI-compatible) and optional internal cost (micro-USD per million tokens; unset = "unknown")
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PRICE_INPUT_MICROS_PER_MTOK=
LLM_PRICE_OUTPUT_MICROS_PER_MTOK=
# Image generation (OpenAI-compatible Images API). Unset = "Requires setup"
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Asset storage: local (dev) | vercel_blob (needs BLOB_READ_WRITE_TOKEN and `npm i @vercel/blob`)
ASSET_STORAGE=local
BLOB_READ_WRITE_TOKEN=
# Signed Stripe webhook → /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Provider apps (OAuth). Optional scope/version overrides once approved.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=
LINKEDIN_API_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_SCOPES=
META_GRAPH_VERSION=
# Development only: explicit TEST publishing account (ignored in production)
GROWTHOS_TEST_ADAPTER=

# --- GrowthOS completion (AI Studio, AI credits, storage, scheduler) ---
# Public https origin providers can fetch signed, expiring media links from (Instagram / Facebook). Defaults to SITE_URL in production.
MEDIA_PUBLIC_ORIGIN=
# Profitability guard for AI credits (lib/os/pricing.ts). Provider prices in micro-USD; FX for every non-USD pack currency.
IMAGE_PRICE_MICROS=
AI_FX_INR_PER_USD=
AI_MIN_MARGIN_PCT=70
# Optional web research for AI Studio (Brave Web Search API). Unset = tools are source-based only. Price per search in micro-USD.
BRAVE_SEARCH_API_KEY=
RESEARCH_PRICE_MICROS=
# DEV ONLY (ignored in production): local stand-in model for browser walkthroughs, see scripts/dev-verify.mjs
GROWTHOS_DEV_LLM=
