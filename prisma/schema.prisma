// Postgres (Neon in production). JSON payloads are stored as String (JSON.stringify)
// so the schema stays provider-portable.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id           String   @id @default(cuid())
  // business (Growth Snapshot) | doctor (Doctor Digital Audit)
  type         String   @default("business")
  email        String
  url          String
  // intake | generating | in_review | needs_attention | delivered | booked | nurture | closed
  status       String   @default("intake")
  // priority | standard | nurture (G1 tag)
  tag          String?
  // sales pipeline: cold | hot | in_pipeline | converted | rejected
  salesStatus  String   @default("cold")
  g1Score      Int?
  g1Components String?
  redFlags     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evidencePack EvidencePack?
  report       Report?
  artifact     InternalArtifact?
  events       Event[]
}

model EvidencePack {
  id            String  @id @default(cuid())
  leadId        String  @unique
  lead          Lead    @relation(fields: [leadId], references: [id])
  scraped       String // JSON: pages, signals, inferred profile
  profile       String? // JSON: user-confirmed profile
  intake        String? // JSON: core intake answers
  moduleAnswers String? // JSON: per-module answers
  competitors   String? // JSON: CompetitorsResult (discovery source, verification, scorecards)
}

model Report {
  id           String    @id @default(cuid())
  leadId       String    @unique
  lead         Lead      @relation(fields: [leadId], references: [id])
  json         String // user-facing report JSON
  version      Int       @default(1)
  // pending | needs_attention | approved | rejected
  status       String    @default("pending")
  criticLog    String?
  reviewerName String?
  reviewNote   String?
  token        String    @unique @default(cuid())
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model InternalArtifact {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id])
  json   String
}

// Customer-specific pricing proposal. `json` holds a full Program object
// (lib/programs Tier shape) so the public page renders with the same components
// as /bundles/[slug]. Shared via /plans/[token].
model CustomPlan {
  id           String    @id @default(cuid())
  token        String    @unique @default(cuid())
  customerName String
  email        String?
  market       String // in | us — the plan is priced for one market only
  json         String // Program JSON
  // draft | sent | accepted | expired
  status       String    @default("draft")
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  type      String
  data      String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales Partner Portal. Money columns are BigInt MINOR units (paise / cents) —
// never floats, never converted between markets. See lib/partner/money.ts.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  // partner | deal_desk | admin | finance | super_admin
  role         String   @default("partner")
  name         String?
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner Partner?
}

model PartnerApplication {
  id                  String   @id @default(cuid())
  // applied | screening | interview | approved | rejected | low_priority
  status              String   @default("applied")
  score               Int?
  scoreBreakdown      String? // JSON
  fullName            String
  email               String
  phone               String?
  country             String?
  city                String?
  linkedinUrl         String?
  companyName         String?
  companyWebsite      String?
  entityType          String?
  yearsExperience     Int?
  industries          String? // JSON string[]
  typicalDealSizeBand String?
  dealExamples        String?
  prospects90dBand    String?
  leadSources         String? // JSON string[]
  markets             String? // JSON string[] of "IN" | "US"
  targetFamilies      String? // JSON string[]
  hasOwnDelivery      Boolean  @default(false)
  hoursPerWeek        Int?
  teamSize            Int?
  expectedDealsBand   String?
  whyCatalyst         String?
  duplicateFlags      String?// JSON — email/phone/linkedin matches, informational only
  reviewerId          String?
  reasonCode          String?
  internalNotes       String?
  convertedPartnerId  String?
  requestedFields     String? // JSON string[] — fields the applicant may edit after "request info"
  statusToken         String   @unique @default(cuid())
  submittedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  partner Partner?
}

model Partner {
  id            String   @id @default(cuid())
  applicationId String?  @unique
  application   PartnerApplication? @relation(fields: [applicationId], references: [id])
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  legalName     String
  entityType    String?
  contactEmail  String
  contactPhone  String?
  markets       String   @default("[]") // JSON string[]
  families      String   @default("[]") // JSON string[]
  // pending_agreement | active | suspended | terminated
  status        String   @default("pending_agreement")
  protectionDays Int     @default(90)
  quoteThresholdTier String @default("T2")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rates       CommissionRate[]
  deals       Deal[]
  commissions Commission[]
  activities  Activity[]
}

// APPEND-ONLY. Never UPDATE, never DELETE. Current rate = latest row with
// effectiveFrom <= today AND approvedAt not null.
model CommissionRate {
  id            String   @id @default(cuid())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id])
  rateBp        Int // basis points; 3000 = 30%
  effectiveFrom DateTime
  reason        String
  setByUserId   String
  // rates above 3000bp need a second admin: null until they do
  approvedAt        DateTime?
  approvedByUserId  String?
  createdAt     DateTime @default(now())

  @@index([partnerId, effectiveFrom])
}

model PriceBook {
  id                 String   @id @default(cuid())
  market             String // IN | US
  currency           String // INR | USD
  family             String
  familyLabel        String
  program            String
  tier               String
  packageName        String
  onboardingFee      BigInt // minor units — the only commissionable amount
  growthPlanMonthly  BigInt? // minor units — displayed, NEVER commissionable
  buildDays          Int?
  billingSchedule    String   @default("50_50") // 50_50 | 40_40_20
  guardrails         String?
  activeFrom         DateTime @default(now())
  activeTo           DateTime?

  deals Deal[]

  @@unique([market, program, tier])
  @@index([market, family])
}

model Client {
  id                 String   @id @default(cuid())
  legalName          String
  domainNormalised   String   @unique
  country            String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  isHouseAccount     Boolean  @default(false)
  existingClientSince DateTime?
  createdAt          DateTime @default(now())

  deals Deal[]
}

model Deal {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  market      String // IN | US — fixed at creation, never changes
  priceBookId String?
  priceBook   PriceBook? @relation(fields: [priceBookId], references: [id])
  // registered | qualified | demo_given | proposal_sent | negotiation | won | lost | lapsed
  stage       String   @default("registered")
  family      String?
  estimatedTier String?
  estimatedValue BigInt? // minor units, partner's guess — never used for commission
  expectedCloseDate DateTime?
  howYouKnowThem String?
  notes       String?
  registeredAt DateTime @default(now())
  protectedUntil DateTime
  proposalSentAt DateTime?
  lastActivityAt DateTime @default(now())
  onboardingFee BigInt? // minor units, copied from price book at quote time
  wonAt       DateTime?
  lostReason  String?
  // the partner's rate at the moment the deal was won — commissions read THIS
  commissionRateBpLocked Int?
  // A partner's PROPOSED custom price — no effect on any money until staff
  // approve it, which routes through the same audited setCustomPrice path.
  customPriceRequested   BigInt?
  customPriceRequestNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities  Activity[]
  invoices    Invoice[]
  commissions Commission[]

  @@index([partnerId, stage])
}

model Invoice {
  id       String   @id @default(cuid())
  dealId   String
  deal     Deal     @relation(fields: [dealId], references: [id])
  amount   BigInt // minor units
  tax      BigInt   @default(0)
  issuedAt DateTime @default(now())
  dueAt    DateTime?
  // issued | paid | credited
  status   String   @default("issued")
  reference String?
  createdAt DateTime @default(now())

  collections Collection[]
}

model Collection {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      BigInt // minor units
  collectedAt DateTime @default(now())
  method      String?
  reference   String?
  createdAt   DateTime @default(now())

  commissions Commission[]
}

model Commission {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id])
  // the base and rate this row was computed with — frozen, never recalculated
  baseAmount BigInt
  rateBp     Int
  amount     BigInt
  currency   String
  // pending | accrued | payable | paid | adjusted | void
  state      String   @default("pending")
  // set when this row was made payable by a specific collection (pro-rata slice)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])
  accruedAt  DateTime?
  payableAt  DateTime?
  paidAt     DateTime?
  payoutRef  String?
  adjustmentOfId String?
  // refund | chargeback | misselling — the ONLY three. No retention clawback:
  // a Growth Plan lapse can never produce an adjustment. Deliberate.
  adjustmentReasonCode String?
  adjustmentReason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([partnerId, state])
}

model Activity {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id])
  type       String
  occurredAt DateTime @default(now())
  notes      String?
}

// ─────────────────────────────────────────────────────────────────────────────
// LeadOS (app.catalystsolutionservices.com). All LeadOS tables are prefixed
// Los* to stay clearly separated from the marketing-site / partner-portal
// tables above. Tenant-owned tables always carry orgId.
// ─────────────────────────────────────────────────────────────────────────────

// Background job queue on Postgres (SKIP LOCKED claim) — no Redis needed.
// ponytail: swap to BullMQ only if job volume ever outgrows a table.
model LosJob {
  id             String    @id @default(cuid())
  type           String
  payload        String? // JSON
  idempotencyKey String?   @unique
  // pending | running | done | failed | dead
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
}

// ── LeadOS identity & tenancy ────────────────────────────────────────────────

model LosUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String?
  emailVerifiedAt DateTime?
  // TOTP secret, AES-256-GCM encrypted at rest (lib/leados/crypto.ts)
  mfaSecretEnc    String?
  mfaEnabledAt    DateTime?
  // Platform-side role, null for ordinary customers:
  // super_admin | compliance_admin | inventory_admin | campaign_admin | support_admin | auditor
  platformRole    String?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // synthetic/demo data flag — one-command wipe
  demo            Boolean   @default(false)

  memberships LosMembership[]
  sessions    LosSession[]
}

model LosOrg {
  id            String    @id @default(cuid())
  name          String
  // b2b | b2c | both
  intendedUse   String    @default("both")
  // IN | US — billing market, fixed at onboarding
  market        String    @default("IN")
  jurisdiction  String?
  industry      String?
  website       String?
  // versioned acceptance captured at onboarding
  termsVersion  String?
  termsAcceptedAt DateTime?
  dpaAcceptedAt DateTime?
  prohibitedUseAcceptedAt DateTime?
  // active | suspended
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  demo          Boolean   @default(false)

  memberships LosMembership[]
  invitations LosInvitation[]
  apiKeys     LosApiKey[]
  leads       LosLead[]

  // CatalystGrowthOS v2 (tenant-safe: every new Cos* table FKs here)
  cosEngagements   CosEngagement[]
  cosProfile       CosBusinessProfile?
  cosSources       CosSource[]
  cosClaims        CosClaim[]
  cosChecklist     CosChecklistItem[]
  cosDependencies  CosDependency[]
  cosCampaigns     CosCampaign[]
  cosVariants      CosContentVariant[]
  cosRevisions     CosRevision[]
  cosAssets        CosAsset[]
  cosPublications  CosPublication[]
  cosSnapshots     CosMetricSnapshot[]
  cosOpportunities CosOpportunity[]
  cosCycles        CosCycle[]
  cosCommercial    CosCommercialRecord[]
  cosPayments      CosPaymentEvent[]
  cosAiUsage       CosAiUsage[]
  cosNotifications CosNotification[]

  // AI credits + client AI Studio (2026-09 completion). Separate from LosTokenLedger (lead tokens).
  cosCreditWallet       CosCreditWallet?
  cosCreditGrants       CosCreditGrant[]
  cosCreditLedger       CosCreditLedger[]
  cosCreditReservations CosCreditReservation[]
  cosCreditQuotes       CosCreditQuote[]
  cosCreditOrders       CosCreditOrder[]
  cosCreditLimits       CosCreditMemberLimit[]
  cosAiBillingAuths     CosAiBillingAuth[]
  cosAiOperations       CosAiOperation[]
}

model LosMembership {
  id        String   @id @default(cuid())
  orgId     String
  org       LosOrg   @relation(fields: [orgId], references: [id])
  userId    String
  user      LosUser  @relation(fields: [userId], references: [id])
  // owner | admin | campaign_manager | sales_manager | sales_rep | analyst
  role      String
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

model LosInvitation {
  id           String    @id @default(cuid())
  orgId        String
  org          LosOrg    @relation(fields: [orgId], references: [id])
  email        String
  role         String
  tokenHash    String    @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([orgId])
}

model LosSession {
  id         String    @id @default(cuid())
  userId     String
  user       LosUser   @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  // true until the user passes TOTP (only when MFA is enabled)
  mfaPending Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// Email verification / password reset links. Single-use, hashed at rest.
model LosEmailToken {
  id        String    @id @default(cuid())
  email     String
  userId    String?
  // verify_email | reset_password
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

model LosApiKey {
  id          String    @id @default(cuid())
  orgId       String
  org         LosOrg    @relation(fields: [orgId], references: [id])
  name        String
  // display prefix ("los_ab12…") + hash of the full secret
  prefix      String
  keyHash     String    @unique
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
}

// ── LeadOS leads & companies ─────────────────────────────────────────────────
// Contact-point uniqueness (one normalized email/phone per org+type scope) is
// enforced in the lead-write paths (create/import/merge) — Prisma has no
// partial unique indexes under db push; indexes below keep the checks fast.

model LosLead {
  id        String  @id @default(cuid())
  orgId     String
  org       LosOrg  @relation(fields: [orgId], references: [id])
  // b2b | b2c
  leadType  String
  // manual | import | api | webhook | form | allocation | enrichment
  source    String  @default("manual")
  sourceRef String? // import id, form id, allocation id…

  firstName String?
  lastName  String?
  email     String?
  // unverified | valid | risky | invalid
  emailStatus String @default("unverified")
  normalizedEmail String?
  phone     String?
  phoneStatus String @default("unverified")
  normalizedPhone String?
  city      String?
  state     String?
  country   String?
  timezone  String?
  language  String?

  // pipeline
  // new | assigned | contacted | engaged | qualified | converted | lost
  status    String   @default("new")
  ownerId   String?  // LosUser id of the assigned rep
  lostReason String?
  conversionValue BigInt? // minor units in the org's market currency

  // Attribution (GrowthOS v2). Set once at capture from campaign-tagged URLs; never inferred later.
  marketingCampaignId String? // CosCampaign.id
  variantId           String? // CosContentVariant.id (utm_content)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  // known (tagged link / ad platform) | self_reported | unknown
  attributionKind    String  @default("unknown")
  selfReportedSource String?

  qualityScore Int?
  intentScore  Int?

  companyId String?
  company   LosCompany? @relation(fields: [companyId], references: [id])

  customFields String? // JSON {defId: value} — defs in LosCustomFieldDef
  enrichment   String? // JSON field-level {field: {value, source, confidence, at}}

  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  verifiedAt  DateTime?
  contactedAt DateTime?
  convertedAt DateTime?
  deletedAt   DateTime? // soft delete (privacy erasure hard-deletes)

  b2b  LosLeadB2b?
  b2c  LosLeadB2c?
  tags LosLeadTag[]

  @@index([orgId, status])
  @@index([orgId, normalizedEmail])
  @@index([orgId, normalizedPhone])
  @@index([orgId, createdAt])
  @@index([orgId, ownerId])
  @@index([orgId, marketingCampaignId])
}

model LosLeadB2b {
  id       String  @id @default(cuid())
  leadId   String  @unique
  lead     LosLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  jobTitle String?
  department String?
  seniority  String?
  workEmail  String?
  directDial String?
  profileUrl String?
  employmentVerifiedAt DateTime?
}

model LosLeadB2c {
  id       String  @id @default(cuid())
  leadId   String  @unique
  lead     LosLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  interests String? // JSON string[] — explicitly collected campaign interests
  productInterest String?
  budgetBand      String?
  purchaseTimeline String?
  preferredChannel String? // whatsapp | sms | email | call
  preferredTime    String?
  // Consent/permission summary — the full evidence trail lives in the Phase 3
  // consent ledger; these are the enforcement columns read at allocation/send.
  permittedPurposes String? // JSON string[]
  permittedChannels String? // JSON string[]
  consentRef        String? // evidence reference (ledger event id / import evidence)
  noticeVersion     String?
  retentionExpiresAt DateTime?
  withdrawnAt        DateTime?
  suppressedAt       DateTime?
}

model LosCompany {
  id     String @id @default(cuid())
  orgId  String
  name   String
  domain String? // normalized, no www
  industry String?
  employeeBand String?
  revenueBand  String?
  city    String?
  country String?
  techAttributes String? // JSON string[]
  demo    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads LosLead[]

  @@index([orgId, domain])
}

model LosTag {
  id    String @id @default(cuid())
  orgId String
  name  String
  leads LosLeadTag[]

  @@unique([orgId, name])
}

model LosLeadTag {
  leadId String
  lead   LosLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId  String
  tag    LosTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model LosCustomFieldDef {
  id    String @id @default(cuid())
  orgId String
  key   String
  label String
  // text | number | select | date | boolean
  kind  String @default("text")
  options String? // JSON string[] for select
  createdAt DateTime @default(now())

  @@unique([orgId, key])
}

// One row per inbound record: provenance for every lead write from outside.
model LosLeadSourceRecord {
  id       String   @id @default(cuid())
  orgId    String
  leadId   String?
  // import | api | webhook | form
  kind     String
  ref      String? // import id / api key id / form id
  raw      String? // JSON of the inbound row (no secrets)
  createdAt DateTime @default(now())

  @@index([orgId, leadId])
}

model LosVerificationEvent {
  id      String   @id @default(cuid())
  orgId   String
  leadId  String
  // email | phone
  channel String
  provider String // basic-mx | manual | <paid provider>
  result  String // valid | risky | invalid | unknown
  detail  String? // JSON
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LosLeadMergeEvent {
  id           String   @id @default(cuid())
  orgId        String
  keptLeadId   String
  mergedLeadId String
  mergedData   String? // JSON snapshot of the merged (removed) record
  actorUserId  String?
  createdAt    DateTime @default(now())

  @@index([orgId, keptLeadId])
}

model LosImport {
  id       String  @id @default(cuid())
  orgId    String
  createdById String
  fileName String
  leadType String // b2b | b2c
  // mapping | previewed | committing | done | failed
  status   String  @default("mapping")
  headers  String  // JSON string[]
  rows     String  // JSON string[][] (capped at MAX_IMPORT_ROWS)
  mapping  String? // JSON {header: field}
  // B2C lawful-use metadata captured at import time
  lawfulUse String? // JSON {purposes, channels, evidenceNote, noticeVersion, retentionDays}
  report   String? // JSON {accepted, skippedDuplicates, invalid, errors[]}
  demo     Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, createdAt])
}

// ── LeadOS inventory, plans, allocation, tokens ──────────────────────────────

model LosDataSource {
  id        String   @id @default(cuid())
  name      String
  // supplier | internal | client_owned
  kind      String   @default("supplier")
  contact   String?
  // contract / permission evidence summary
  contractEvidence String?
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())

  datasets LosDataset[]
}

model LosDataset {
  id        String   @id @default(cuid())
  sourceId  String
  source    LosDataSource @relation(fields: [sourceId], references: [id])
  name      String
  leadType  String // b2b | b2c
  // draft | validating | compliance_review | approved | rejected | quarantined
  status    String   @default("draft")
  headers   String // JSON string[]
  rows      String // JSON string[][] until approval materializes inventory
  mapping   String? // JSON {header: field}
  // b2c lawful use: {purposes, channels, evidenceNote, noticeVersion, retentionDays}
  lawfulUse String?
  // targeting restrictions on where these records may be used
  geographyRestriction String? // JSON {countries?: [], states?: []}
  purposeRestriction   String? // JSON string[] — campaign purposes allowed
  // exclusive | shared
  exclusivity String @default("exclusive")
  maxShare    Int    @default(1)
  coolingDays Int    @default(0)
  expiryDays  Int?   // records expire this many days after approval
  report    String? // JSON validation/materialization report
  createdById String?
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records LosInventoryRecord[]

  @@index([status])
}

model LosInventoryRecord {
  id        String   @id @default(cuid())
  datasetId String
  dataset   LosDataset @relation(fields: [datasetId], references: [id])
  leadType  String
  fields    String // JSON LeadInput
  normalizedEmail String?
  normalizedPhone String?
  city      String?
  state     String?
  country   String?
  qualityScore Int  @default(50)
  // available | reserved | allocated | suppressed | expired | quarantined | deleted
  status    String   @default("available")
  allocationCount Int @default(0)
  maxAllocations  Int @default(1)
  reservedForOrgId String?
  lastAllocatedAt DateTime?
  expiresAt  DateTime?
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations LosAllocation[]

  @@index([status, leadType, country])
  @@index([datasetId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
}

model LosLeadPlan {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  leadType  String // b2b | b2c
  dailyQuota Int
  startDate DateTime
  endDate   DateTime?
  // JSON int[] ISO weekday numbers 1(Mon)..7(Sun)
  workingDays String @default("[1,2,3,4,5]")
  // JSON "YYYY-MM-DD"[] holidays skipped
  holidays  String @default("[]")
  deliveryTimezone String @default("Asia/Kolkata")
  deliveryHour     Int    @default(9)
  // campaign purpose for the compliance engine
  purpose   String @default("sales_contact")
  targeting String? // JSON {countries?: [], states?: [], cities?: []}
  minQuality Int   @default(0)
  // exclusive | shared
  exclusivity String @default("exclusive")
  // none | week | campaign_end | approval
  rolloverPolicy String @default("none")
  // dashboard | webhook
  deliveryMethod String @default("dashboard")
  webhookUrl String?
  priority  Int      @default(0)
  // active | paused | ended
  status    String   @default("active")
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs        LosAllocationRun[]
  allocations LosAllocation[]

  @@index([status, orgId])
}

model LosAllocationRun {
  id        String   @id @default(cuid())
  planId    String
  plan      LosLeadPlan @relation(fields: [planId], references: [id])
  runDate   String // "YYYY-MM-DD" in the plan's delivery timezone
  // executed | failed
  status    String
  due       Int
  allocated Int
  shortage  Int
  // JSON: {reasons: {reason: count}, rollover: n}
  detail    String?
  createdAt DateTime @default(now())

  allocations LosAllocation[]

  @@unique([planId, runDate])
}

// IMMUTABLE after creation. State moves forward only; money/token corrections
// happen via compensating ledger entries, never by editing these rows.
model LosAllocation {
  id        String   @id @default(cuid())
  runId     String
  run       LosAllocationRun @relation(fields: [runId], references: [id])
  planId    String
  plan      LosLeadPlan @relation(fields: [planId], references: [id])
  orgId     String
  inventoryRecordId String
  inventoryRecord   LosInventoryRecord @relation(fields: [inventoryRecordId], references: [id])
  leadId    String? // the LosLead created in the client org
  // delivered | accepted | replacement_requested | replaced | rejected
  state     String   @default("delivered")
  tokensCharged Int
  rateSnapshot  String? // JSON of the rate math at debit time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replacement LosLeadReplacement?

  @@unique([inventoryRecordId, orgId]) // one org never gets the same record twice
  @@index([orgId, createdAt])
  @@index([planId])
}

model LosLeadReplacement {
  id           String   @id @default(cuid())
  allocationId String   @unique
  allocation   LosAllocation @relation(fields: [allocationId], references: [id])
  reason       String
  // requested | approved | rejected
  status       String   @default("requested")
  decisionNote String?
  decidedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// APPEND-ONLY token ledger. Balance = SUM(delta). Never UPDATE or DELETE.
model LosTokenLedger {
  id     String @id @default(cuid())
  orgId  String
  delta  Int // + credit, - debit
  // purchase | grant | adjustment | allocation_debit | replacement_credit |
  // reveal_debit | enrichment_debit
  kind   String
  refId  String? // allocation id, stripe payment id, …
  note   String?
  createdById String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// Effective-dated token rate card. Latest row with effectiveFrom <= now wins
// per (leadType, industry); industry null = default. APPEND-ONLY.
model LosTokenRate {
  id        String   @id @default(cuid())
  leadType  String // b2b | b2c
  industry  String? // normalized industry label; null = default
  exclusiveTokens Int
  sharedTokens    Int
  verifiedBonusPct Int @default(50) // % surcharge when phone/email verified
  effectiveFrom DateTime @default(now())
  createdById   String?
  createdAt DateTime @default(now())

  @@index([leadType, industry, effectiveFrom])
}

// ── LeadOS billing, analytics, integrations ──────────────────────────────────

model LosSubscription {
  orgId    String @id
  stripeSubscriptionId String? @unique
  // lead_manager | growth | managed_leads | agency | enterprise
  package  String @default("lead_manager")
  // active | past_due | canceled | none
  status   String @default("none")
  currentPeriodEnd DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Pre-aggregated per-org daily metrics for dashboards + reports.
model LosDailyMetric {
  id     String @id @default(cuid())
  orgId  String
  date   String // YYYY-MM-DD
  metrics String // JSON {leadsCreated, bySource, delivered, contacted, converted, submissions, views, messagesSent, tokensSpent}
  createdAt DateTime @default(now())

  @@unique([orgId, date])
}

// Outbound webhooks (Zapier/Make/n8n/CRM glue). HMAC-signed deliveries with
// job-queue retries; repeated failures surface in the integrations page.
model LosWebhook {
  id     String @id @default(cuid())
  orgId  String
  url    String
  secret String
  // JSON string[] of: lead.created | lead.status_changed | leads.delivered
  events String @default("[\"lead.created\"]")
  active Boolean @default(true)
  failCount Int @default(0)
  lastStatus String?
  lastFiredAt DateTime?
  createdAt DateTime @default(now())

  @@index([orgId])
}

// Per-org integration settings that are just config (no OAuth): Slack incoming
// webhook, etc. JSON keyed by integration name.
model LosIntegrationConfig {
  orgId  String @id
  config String // JSON {slackWebhookUrl?: string}
  updatedAt DateTime @updatedAt
}

// ── LeadOS B2B discovery ─────────────────────────────────────────────────────

model LosSavedSearch {
  id      String  @id @default(cuid())
  orgId   String
  name    String
  // people | companies
  kind    String  @default("people")
  filters String // JSON B2bSearchFilters
  alert   Boolean @default(false)
  lastCount Int?
  lastAlertAt DateTime?
  createdById String
  createdAt DateTime @default(now())

  @@index([orgId])
}

model LosList {
  id     String @id @default(cuid())
  orgId  String
  name   String
  // leads | companies
  kind   String @default("leads")
  createdById String
  createdAt DateTime @default(now())

  members LosListMember[]

  @@index([orgId])
}

model LosListMember {
  listId String
  list   LosList @relation(fields: [listId], references: [id], onDelete: Cascade)
  // LosLead id or LosInventoryRecord id depending on list kind
  refId  String
  addedAt DateTime @default(now())

  @@id([listId, refId])
}

// Domains an org never wants to see in discovery (their clients, competitors…).
model LosExclusion {
  id     String @id @default(cuid())
  orgId  String
  domain String
  createdAt DateTime @default(now())

  @@unique([orgId, domain])
}

// One reveal per org+record: pay once, see it forever.
model LosReveal {
  id       String @id @default(cuid())
  orgId    String
  recordId String
  leadId   String?
  tokensCharged Int
  revealedById String
  createdAt DateTime @default(now())

  @@unique([orgId, recordId])
  @@index([orgId, createdAt])
}

// ── LeadOS sales workflow: pipeline, tasks, outreach, scoring ────────────────

// Custom pipeline stages per org. System defaults seeded on first read.
model LosPipelineStage {
  id     String @id @default(cuid())
  orgId  String
  key    String
  label  String
  order  Int
  isWon  Boolean @default(false)
  isLost Boolean @default(false)

  @@unique([orgId, key])
}

model LosTask {
  id         String    @id @default(cuid())
  orgId      String
  leadId     String?
  assigneeId String
  title      String
  // call | follow_up | other
  kind       String    @default("follow_up")
  dueAt      DateTime
  doneAt     DateTime?
  createdById String
  demo       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([orgId, assigneeId, doneAt, dueAt])
  @@index([leadId])
}

model LosNote {
  id       String   @id @default(cuid())
  orgId    String
  leadId   String
  authorId String
  body     String
  mentions String? // JSON userId[]
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Unified lead timeline: stage_change | note | task_created | task_done |
// assigned | message_sent | message_event | replacement | score
model LosActivity {
  id      String   @id @default(cuid())
  orgId   String
  leadId  String
  kind    String
  actorId String?
  data    String? // JSON
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model LosMessageTemplate {
  id      String @id @default(cuid())
  orgId   String
  name    String
  // whatsapp | sms | email
  channel String
  subject String?
  body    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, channel])
}

model LosSequence {
  id     String @id @default(cuid())
  orgId  String
  name   String
  // active | paused
  status String @default("active")
  createdAt DateTime @default(now())

  steps       LosSequenceStep[]
  enrollments LosSequenceEnrollment[]
}

model LosSequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  sequence   LosSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  channel    String
  templateId String
  delayHours Int    @default(24)

  @@unique([sequenceId, order])
}

model LosSequenceEnrollment {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   LosSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  orgId      String
  leadId     String
  currentStep Int     @default(0)
  // active | completed | stopped_reply | stopped_optout | stopped_manual | stopped_converted | blocked
  status     String   @default("active")
  nextRunAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sequenceId, leadId])
  @@index([status, nextRunAt])
}

model LosOutboundMessage {
  id         String   @id @default(cuid())
  orgId      String
  leadId     String
  // whatsapp | sms | email
  channel    String
  toAddress  String
  subject    String?
  body       String
  templateId String?
  sequenceId String?
  // sent | failed | blocked | dev_logged
  status     String
  blockReason String?
  providerRef String?
  optOutToken String? @unique
  sentById   String? // null = system/sequence
  createdAt  DateTime @default(now())

  events LosMessageEvent[]

  @@index([orgId, channel, createdAt])
  @@index([leadId, createdAt])
}

model LosMessageEvent {
  id        String   @id @default(cuid())
  messageId String
  message   LosOutboundMessage @relation(fields: [messageId], references: [id])
  // delivered | bounce | reply | optout
  kind      String
  data      String?
  createdAt DateTime @default(now())

  @@index([messageId])
}

model LosScoringConfig {
  orgId   String @id
  weights String // JSON — see lib/leados/scoring.ts DEFAULT_WEIGHTS
  updatedAt DateTime @updatedAt
}

model LosScoreEvent {
  id      String   @id @default(cuid())
  orgId   String
  leadId  String
  quality Int
  intent  Int
  explanation String // JSON breakdown
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// ── LeadOS B2C campaign generation ───────────────────────────────────────────

model LosCampaign {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  // hosted_page | embedded_form | meta_ads | google_ads | whatsapp | qr_offline | referral
  type      String   @default("hosted_page")
  // generate_inquiries | book_consultations | request_quotes | collect_registrations | build_waitlist | request_demos
  objective String   @default("generate_inquiries")
  // draft | in_review | approved | scheduled | active | paused | completed | rejected
  status    String   @default("draft")
  publicId  String   @unique @default(cuid())
  // {product, description, geography, language, startDate, endDate, budget, expectedVolume}
  offer     String?
  // {fields: FormField[], qualifying: FormField[], otpVerify: bool, emailVerify: bool,
  //  consentPurposes: string[], consentChannels: string[], doubleOptIn: bool}
  formSpec  String?
  // {template, headline, body, cta, brandColor, thankYouMessage, thankYouRedirect, whatsappNumber, calendarUrl}
  pageSpec  String?
  // {mode: round_robin|fixed, userIds: string[], slaMinutes, ackEmail: bool, ackTemplate}
  distribution String?
  noticeVersion String @default("v1")
  // CosCampaign.id this lead-capture form serves (marketing campaign ≠ capture form)
  marketingCampaignId String?
  reviewNote   String?
  launchedAt   DateTime?
  demo      Boolean  @default(false)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions    LosCampaignVersion[]
  submissions LosFormSubmission[]
  trackingLinks LosTrackingLink[]

  @@index([orgId, status])
}

// Published snapshots — the live hosted page renders the latest version, so
// edits to a draft never change what's already public until re-publish.
model LosCampaignVersion {
  id         String   @id @default(cuid())
  campaignId String
  campaign   LosCampaign @relation(fields: [campaignId], references: [id])
  version    Int
  formSpec   String
  pageSpec   String
  publishedAt DateTime @default(now())

  @@unique([campaignId, version])
}

model LosFormSubmission {
  id         String   @id @default(cuid())
  campaignId String
  campaign   LosCampaign @relation(fields: [campaignId], references: [id])
  orgId      String
  data       String // JSON of submitted fields (validated)
  // {purposes: string[], channels: string[], noticeVersion, textShown}
  consent    String?
  utm        String? // JSON utm/tracking params
  trackingCode String?
  ip         String?
  // WP-10a scorecard result JSON {total, max, pct, band, bandIndex, categories:[{key,label,pillar,points,max,pct}]} — self-reported
  score      String?
  // accepted | duplicate_updated | invalid | spam | pending_verification
  status     String
  leadId     String?
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@index([orgId])
}

model LosTrackingLink {
  id         String   @id @default(cuid())
  campaignId String
  campaign   LosCampaign @relation(fields: [campaignId], references: [id])
  code       String   @unique
  label      String
  createdAt  DateTime @default(now())
}

model LosAttributionEvent {
  id         String   @id @default(cuid())
  campaignId String
  // view | submit
  kind       String
  trackingCode String?
  utm        String?
  createdAt  DateTime @default(now())

  @@index([campaignId, kind, createdAt])
}

// External ad-platform connections (Meta / Google). Tokens AES-encrypted.
model LosAdConnection {
  id       String   @id @default(cuid())
  orgId    String
  // meta | google
  provider String
  // pending | connected | error | revoked
  status   String   @default("pending")
  configEnc String? // encrypted JSON: tokens, page/form ids
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, provider])
}

model LosExternalCampaign {
  id         String   @id @default(cuid())
  campaignId String
  provider   String
  externalId String
  status     String @default("linked")
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
}

// ── LeadOS consent & governance ──────────────────────────────────────────────

// APPEND-ONLY consent/permission ledger (blueprint §6.2). Never UPDATE/DELETE.
model LosConsentEvent {
  id        String   @id @default(cuid())
  orgId     String?  // null = platform-scope (admin-supplied inventory)
  leadId    String?
  // hash of the normalized contact point — survives lead deletion
  contactHash String
  // notice_presented | consent_given | consent_refused | withdrawal | objection |
  // suppression | access | correction | deletion | import_evidence
  kind      String
  purpose   String?  // purpose code the event applies to
  channel   String?  // channel code the event applies to
  noticeVersion String?
  language  String?
  sourceApp String?  // campaign/form/import id
  evidenceRef String? // free-text or storage pointer
  data      String?  // JSON extras — never raw personal data
  createdAt DateTime @default(now())

  @@index([contactHash])
  @@index([leadId])
  @@index([orgId, createdAt])
}

// Suppression list. scope "org" (one tenant) or "global" (platform-wide).
model LosSuppressionEntry {
  id          String   @id @default(cuid())
  contactHash String
  // org | global
  scope       String   @default("org")
  orgId       String?  // required when scope=org
  // withdrawal | complaint | privacy_request | admin | bounce
  reason      String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([contactHash, scope, orgId])
  @@index([contactHash])
}

// Data-subject requests (blueprint §6.4).
model LosPrivacyRequest {
  id        String   @id @default(cuid())
  // access | correction | deletion | objection
  kind      String
  email     String?
  phone     String?
  contactHashes String // JSON string[] of normalized contact hashes
  details   String?
  // received | identity_verification | in_progress | completed | rejected
  status    String   @default("received")
  identityVerifiedAt DateTime?
  verifyTokenHash    String?  @unique
  resolutionNote String?
  resultPackage  String? // JSON access package (for access requests)
  dueAt     DateTime
  completedAt DateTime?
  handledById String?
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
}

// Generic compliance review queue: datasets, campaigns, imports.
model LosComplianceReview {
  id         String   @id @default(cuid())
  // dataset | campaign | import
  subjectKind String
  subjectId   String
  orgId       String?
  // pending | approved | rejected | quarantined
  status      String   @default("pending")
  submittedById String?
  reviewedById  String?
  note        String?
  evidence    String? // JSON summary shown to the reviewer
  demo        Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([subjectKind, subjectId])
}

// Versioned privacy notices (used by hosted forms in the campaign phase).
model LosPrivacyNotice {
  id        String   @id @default(cuid())
  orgId     String?  // null = platform default
  version   String
  language  String   @default("en")
  title     String
  body      String
  createdAt DateTime @default(now())

  @@unique([orgId, version, language])
}

// APPEND-ONLY. Every specified mutation writes one. Never UPDATE or DELETE.
model LosAuditEvent {
  id          String   @id @default(cuid())
  orgId       String?
  actorUserId String?
  // user | platform_admin | api_key | system
  actorType   String
  action      String
  entity      String
  entityId    String?
  // JSON context — never raw personal data or secrets
  data        String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([entity, entityId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String?
  entity    String
  entityId  String
  action    String
  beforeJson String?
  afterJson  String?
  reason    String?
  ip        String?
  at        DateTime @default(now())

  @@index([entity, entityId])
}

// ═════════════════════════════════════════════════════════════════════════════
// CatalystGrowthOS (Cos*) — the services-delivery layer on top of LeadOS.
// Blueprint: docs/os/blueprint.md. Tenant = LosOrg (orgId everywhere).
// JSON payloads are Strings, like the rest of this schema.
// ═════════════════════════════════════════════════════════════════════════════

// One row per org: workspace kind, brand knowledge, autonomy policy, kill switch.
model CosWorkspace {
  orgId        String    @id
  // prospect (audit/route only) | client (contracted modules)
  kind         String    @default("prospect")
  // marketing-site Lead.id this workspace was claimed from (no FK — marketing tables are untouched)
  sourceLeadId String?
  partnerId    String?
  // JSON {voice, audience, offers, proofPoints, dos, donts, competitors}
  brandProfile String?
  // JSON {publish:{enabled,dailyCap}, email:{...}} — Tier 2 opt-ins; Tier 3 is never autonomous
  autonomy     String?
  // blocks every new outbound job for this org while true
  killSwitch   Boolean   @default(false)
  killSwitchAt DateTime?
  killSwitchBy String?
  // IANA zone used to DISPLAY and ENTER times; storage is always UTC
  timezone     String    @default("UTC")
  // reporting currency (ISO 4217); null = fall back to the org market
  currency     String?
  // active | read_only (handover: history visible, nothing editable) | revoked
  accessMode   String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  demo         Boolean   @default(false)
}

// Contracted scope. Entitlements = union of ACTIVE contracts. Never edited after
// signing — a scope change is a new contract row (kind=change) linked by parentId.
model CosContract {
  id          String    @id @default(cuid())
  orgId       String
  parentId    String?
  // program | change | project | addon
  kind        String    @default("program")
  engagementId String?
  programSlug String?
  // foundation | growth | scale
  tier        String?
  // JSON string[] of service slugs / module keys (lib/os/catalog.ts)
  services    String    @default("[]")
  modules     String    @default("[]")
  // JSON {deliverablesPerMonth, reviewCycles, aiCredits, responseHours}
  allowances  String    @default("{}")
  // TOOL ENTITLEMENT: JSON string[] of AI Studio tool keys (lib/os/studio.ts), independent of
  // `services` (scope) and of the credit balance. Only ACTIVE contracts grant tools.
  aiTools     String    @default("[]")
  scopeDoc    String?
  exclusions  String?
  // JSON {setup, monthly, currency} — placeholder until the price book is decided
  pricing     String?
  // proposed | active | ended | declined
  status      String    @default("proposed")
  proposedBy  String?
  signedById  String?
  signedAt    DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  demo        Boolean   @default(false)

  @@index([orgId, status])
}

model CosAuditRun {
  id             String   @id @default(cuid())
  orgId          String
  sourceLeadId   String?
  url            String
  // initial | quarterly | service | scorecard (self-reported, WP-10b)
  kind           String   @default("initial")
  // WP-10b: the LosFormSubmission this scorecard run came from (one run per submission), and the verified run it pairs with
  sourceSubmissionId String?
  pairedRunId    String?
  // self_reported for scorecard runs; null = verified pipeline
  label          String?
  scoringVersion String
  // JSON {pillarKey: {score|null, label}} — null = unavailable, never 0
  scores         String
  // JSON {snapshot, keyPoints, routes, icps, quickWins, assumptions, limitations}
  summary        String
  reviewedById   String?
  createdAt      DateTime @default(now())
  demo           Boolean  @default(false)

  @@index([orgId, createdAt])
  @@index([sourceSubmissionId])
}

// A finding carries its own evidence. ponytail: one evidence per finding inline;
// split into a CosEvidence table when a finding needs several sources.
model CosFinding {
  id         String   @id @default(cuid())
  orgId      String
  auditRunId String
  pillar     String
  text       String
  severity   String   @default("medium")
  // verified | detected | assumed | unavailable
  label      String
  evidence   String
  sourceUrl  String?
  observedAt DateTime
  // identified | evidence_checked | proposed | accepted | deferred | rejected | archived
  status     String   @default("identified")
  statusNote String?
  workItemId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId, status])
  @@index([auditRunId])
}

// INSERT-ONLY. A correction is a new row with supersedesId — never an UPDATE.
model CosBaseline {
  id           String   @id @default(cuid())
  orgId        String
  version      Int
  auditRunId   String?
  // JSON {scores, kpis, working, notWorking, opportunities}
  snapshot     String
  supersedesId String?
  reason       String?
  approvedById String
  createdAt    DateTime @default(now())

  @@unique([orgId, version])
}

model CosGoal {
  id           String    @id @default(cuid())
  orgId        String
  engagementId String?
  // visibility | acquisition | retention | operations | product
  focus        String?
  // growth pillar (lib/os/pillars.ts): market_intelligence | client_acquisition | digital_visibility | digital_presence | business_operations
  pillar       String?
  metric       String
  target       Float
  unit         String
  horizon      String
  currency     String?
  definition   String?
  // measured | estimated | unavailable
  currentLabel String    @default("unavailable")
  currentValue Float?
  agreedAt     DateTime?
  agreedById   String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([orgId])
}

// AI CMO plan versions. Approved versions are immutable; a replan is version+1.
model CosPlan {
  id           String    @id @default(cuid())
  orgId        String
  version      Int
  // draft | in_review | approved | rejected | superseded
  status       String    @default("draft")
  // JSON {summary, allocation:[{channel,pct,rationale,evidenceIds}], focus, assumptions, risks, alternatives, successMetrics}
  payload      String
  // ai | human
  origin       String    @default("ai")
  model        String?
  reviewedById String?
  approvedById String?
  approvedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())

  @@unique([orgId, version])
}

// The Growth Work Item (blueprint §9.1): one ledger for tasks, content, projects,
// experiments and change requests. Core fields are columns; field groups are JSON.
model CosWorkItem {
  id                   String    @id @default(cuid())
  orgId                String
  parentId             String?
  contractId           String?
  findingId            String?
  planId               String?
  // GrowthOS v2 links (the traceable chain)
  engagementId         String?
  goalId               String?
  campaignId           String?
  cycleId              String?
  // catalyst | client | shared
  responsibility       String    @default("catalyst")
  // role expected to do the work (strategist, designer, developer, editor…)
  assignRole           String?
  acceptanceCriteria   String?
  // how this item's result is judged (template measure or free text)
  measure              String?
  // set ONCE when the item first reaches delivered — reporting counts this, never updatedAt
  deliveredAt          DateTime?
  // task | content | project | milestone | experiment | change_request
  type                 String    @default("task")
  serviceSlug          String?
  studio               String?
  templateKey          String?
  title                String
  // see lib/os/workflow.ts WORK_STATES
  state                String    @default("backlog")
  // state to return to when unblocked
  stateBefore          String?
  version              Int       @default(1)
  priority             Int       @default(2)
  // autonomy tier 0-3 (lib/os/workflow.ts)
  riskTier             Int       @default(1)
  clientReviewRequired Boolean   @default(true)
  ownerId              String?
  assigneeId           String?
  reviewerId           String?
  dueAt                DateTime?
  scheduledAt          DateTime?
  // JSON {problem, objective, options, rationale, successMeasure, tradeoffs, dependencies}
  decision             String?
  // JSON {inScope, estMinutes, estAiCost, incrementalCharge, paymentStatus}
  commercial           String?
  // JSON type-specific body: content {channel, persona, hook, format, cta, body}; checklist [...]
  payload              String?
  // sha256 of title+payload at the current version — approvals bind to this
  contentHash          String?
  // JSON {qa, externalId, kpi, attributionGrade, learningId, closeReason}
  outcome              String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  closedAt             DateTime?
  demo                 Boolean   @default(false)

  events       CosWorkEvent[]
  approvals    CosApproval[]
  deliverables CosDeliverable[]

  @@index([orgId, state])
  @@index([orgId, type, scheduledAt])
  @@index([assigneeId, state])
  @@index([parentId])
  @@index([orgId, engagementId])
  @@index([orgId, campaignId])
  @@index([orgId, deliveredAt])

  variants     CosContentVariant[]
}

// APPEND-ONLY. Transitions, comments, time and AI cost. Never UPDATE or DELETE.
model CosWorkEvent {
  id           String      @id @default(cuid())
  orgId        String
  workItemId   String
  workItem     CosWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorId      String?
  // user | platform_admin | system | ai
  actorType    String
  // transition | comment | time | ai | approval | execution | edit
  kind         String
  fromState    String?
  toState      String?
  minutes      Int?
  // AI/media cost in micro-USD so margins can be computed later
  aiCostMicros Int?
  model        String?
  // internal events are hidden from client roles
  internal     Boolean     @default(false)
  data         String?
  // set when the comment/edit concerns one channel variant
  variantId    String?
  createdAt    DateTime    @default(now())

  @@index([variantId])
  @@index([workItemId, createdAt])
  @@index([orgId, createdAt])
}

model CosDeliverable {
  id           String      @id @default(cuid())
  orgId        String
  workItemId   String
  workItem     CosWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  title        String
  // ponytail: links, not uploads — add blob storage when a client needs files hosted here
  url          String?
  note         String?
  version      Int         @default(1)
  acceptedAt   DateTime?
  acceptedById String?
  createdById  String?
  createdAt    DateTime    @default(now())

  @@index([workItemId])
}

// Approval rows are decided once; a material change means a NEW row for the new version.
model CosApproval {
  id            String       @id @default(cuid())
  orgId         String
  workItemId    String?
  workItem      CosWorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  // work_item | plan | contract | baseline | variant
  subject       String       @default("work_item")
  subjectId     String
  version       Int
  contentHash   String
  // client | internal
  audience      String       @default("client")
  summary       String
  // JSON action diff shown to the approver
  diff          String?
  // requested | approved | approved_with_edits | rejected | expired | revoked
  status        String       @default("requested")
  requestedById String?
  decidedById   String?
  reason        String?
  // single-use emailed approval link (sha256 at rest)
  linkTokenHash String?      @unique
  expiresAt     DateTime?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([orgId, status])
  @@index([subject, subjectId])
}

model CosLearning {
  id          String   @id @default(cuid())
  orgId       String
  hypothesis  String
  segment     String?
  window      String?
  method      String?
  counts      String?
  result      String
  uncertainty String?
  workItemIds String   @default("[]")
  // proposed | approved | rejected
  status      String   @default("proposed")
  reviewerId  String?
  createdAt   DateTime @default(now())

  @@index([orgId, status])
}

// Monthly note / weekly brief. Published reports are immutable.
model CosReport {
  id          String    @id @default(cuid())
  orgId       String
  // weekly | monthly | quarterly
  kind        String
  period      String
  // JSON {metrics:[{name,value,label,baseline}], narrative, delivered, next, limitations}
  body        String
  // draft | published
  status      String    @default("draft")
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([orgId, kind, period])
}

// OAuth / API connections. "verified" only after a live access test passes.
model CosConnection {
  id              String    @id @default(cuid())
  orgId           String
  provider        String
  // provider-specific: member | organization | page | ig_business | channel | site | property | user
  accountType     String?
  // the provider's own id for the account (urn, page id, channel id, site url…)
  externalAccountId String?
  // what THIS authorisation can do, proven by scopes + eligibility: publish | analytics
  capabilities    String[]  @default([])
  // why a capability is missing (e.g. 'Page role is not admin')
  eligibilityNote String?
  // last time a real call with this token succeeded
  liveVerifiedAt  DateTime?
  accountLabel    String?
  // pending | verified | failed | disconnected
  status          String    @default("pending")
  // AES-256-GCM via lib/leados/crypto — never logged
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scopes          String?
  // JSON provider config (gsc site url, ga property id…)
  config          String?
  lastCheckedAt   DateTime?
  lastError       String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([orgId, provider, externalAccountId])
  @@index([orgId, provider])
}

// Pulled channel metrics (GSC, GA, Ads). Idempotent upsert per day+metric.
model CosMetricPoint {
  id       String   @id @default(cuid())
  orgId    String
  provider String
  metric   String
  day      DateTime
  value    Float
  // A | B | C | D attribution grade where relevant
  grade    String?

  @@unique([orgId, provider, metric, day])
}

// ── CatalystGrowthOS automations (lib/os/automation) ─────────────────────────

// A client-built workflow: one trigger, then conditions / waits / actions.
// Only the ACTIVATED definition runs: activeHash must equal the hash of
// `definition`, so any logic edit drops the workflow back to draft.
model CosWorkflow {
  id            String    @id @default(cuid())
  orgId         String
  name          String
  description   String?
  templateKey   String?
  // draft | active | paused | archived
  status        String    @default("draft")
  version       Int       @default(1)
  // JSON {nodes:[{id,type,config,position}], edges:[{from,to,branch?}]}
  definition    String
  // trigger block type, denormalised for event lookup
  triggerType   String?
  activeHash    String?
  activatedById String?
  activatedAt   DateTime?
  // sha256 of the unguessable inbound-webhook token
  hookTokenHash String?   @unique
  // JSON scratch state owned by blocks (e.g. feed items already seen)
  state         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  demo          Boolean   @default(false)

  runs CosWorkflowRun[]

  @@index([orgId, status])
  @@index([orgId, triggerType, status])
}

model CosWorkflowRun {
  id              String      @id @default(cuid())
  orgId           String
  workflowId      String
  workflow        CosWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion Int
  // one run per (workflow, event) — a redelivered event never runs twice
  eventKey        String
  trigger         String
  // queued | running | waiting | succeeded | failed | blocked
  status          String      @default("queued")
  // loop guard: events caused by a workflow carry depth+1
  depth           Int         @default(0)
  // JSON execution context {trigger:{…}, steps:{nodeId:output}} — never logged
  context         String
  // node to continue from after a wait
  cursor          String?
  resumeAt        DateTime?
  error           String?
  stepCount       Int         @default(0)
  createdAt       DateTime    @default(now())
  finishedAt      DateTime?

  steps CosWorkflowStepLog[]

  @@unique([workflowId, eventKey])
  @@index([orgId, createdAt])
  @@index([status, resumeAt])
}

// APPEND-ONLY. One row per executed step. `summary` is redacted of emails/phones.
model CosWorkflowStepLog {
  id        String         @id @default(cuid())
  orgId     String
  runId     String
  run       CosWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String
  blockType String
  // ok | skipped | blocked | failed | waiting
  status    String
  summary   String?
  // WP-18 run inspector: the rendered config the step received and what it returned — redacted JSON, truncated
  input     String?
  output    String?
  ms        Int?
  createdAt DateTime       @default(now())

  @@index([runId, createdAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// CatalystGrowthOS v2 — engagements, content variants, assets, publications,
// dimensional metrics, opportunities, commercial records. All additive.
// Org FKs cascade: an org is only ever deleted by the demo wipe / test cleanup, never by a product flow.
// Every table FKs to LosOrg (tenant) and to its parent; states are documented
// strings validated in lib/os/* (repo convention — no Prisma enums).
// ═════════════════════════════════════════════════════════════════════════════

// One commercial + delivery relationship. An org can have several.
model CosEngagement {
  id            String    @id @default(cuid())
  orgId         String
  org           LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  // audit | direct | partner
  entrySource   String    @default("direct")
  // marketing Lead.id / partner Deal.id — plain ids by rule (those tables are never altered).
  sourceLeadId  String?
  // unique ⇒ linking a partner deal twice can never create a second engagement
  partnerDealId String?   @unique
  // visibility | acquisition | retention | operations | product
  goalFocus     String[]  @default([])
  // prospect | discovery | proposal | accepted | onboarding | active | review | completed | offboarded | declined
  stage         String    @default("prospect")
  // none | awaiting_client | blocked | paused — orthogonal to stage
  hold          String    @default("none")
  holdReason    String?
  holdOwnerId   String?
  holdSince     DateTime?
  nextAction        String?
  nextActionOwnerId String?
  // client | catalyst
  nextActionSide    String?
  nextActionDueAt   DateTime?
  // assets_ready | foundation_needed | unknown
  readiness     String    @default("unknown")
  // Payment is tracked separately from delivery.
  // not_invoiced | invoiced | part_paid | paid | overdue | refunded
  paymentStatus String    @default("not_invoiced")
  currency      String?
  setupFeeMinor     BigInt?
  recurringFeeMinor BigInt?
  // none | monthly | quarterly
  billingInterval   String  @default("none")
  // service expectations — configured per engagement, never defaulted to a promise
  reviewCycles      Int?
  responseHours     Int?
  startsAt      DateTime?
  endsAt        DateTime?
  renewalAt     DateTime?
  renewalNoticeDays Int     @default(30)
  // auto | manual | none
  renewalMode   String    @default("manual")
  kickoffSummary String?
  ownerId       String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?
  demo          Boolean   @default(false)

  events     CosEngagementEvent[]
  checklist  CosChecklistItem[]
  campaigns  CosCampaign[]
  cycles     CosCycle[]
  commercial CosCommercialRecord[]

  @@index([orgId, stage])
  @@index([renewalAt])
}

// APPEND-ONLY stage / hold / payment history.
model CosEngagementEvent {
  id           String        @id @default(cuid())
  orgId        String
  engagementId String
  engagement   CosEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  // stage | hold | payment | note | renewal | handover
  kind         String
  fromValue    String?
  toValue      String?
  reason       String?
  actorId      String?
  actorType    String        @default("user")
  createdAt    DateTime      @default(now())

  @@index([engagementId, createdAt])
}

// Structured discovery — one per org, versioned by counter; prompts read THIS.
model CosBusinessProfile {
  orgId         String   @id
  org           LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  businessModel String?
  audience      String?
  offers        String?
  geography     String?
  website       String?
  tools         String?
  salesProcess  String?
  baseline      String?
  targets       String?
  constraints   String?
  competitors   String?
  brandVoice    String?
  contentPillars String[] @default([])
  version       Int      @default(1)
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

// Research / source material content may be grounded in.
model CosSource {
  id        String   @id @default(cuid())
  orgId     String
  org       LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     String
  // url | document | transcript | note
  kind      String   @default("note")
  url       String?
  assetId   String?
  excerpt   String?
  version   Int      @default(1)
  archivedAt DateTime?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// Claims the client has approved for use in copy.
model CosClaim {
  id          String   @id @default(cuid())
  orgId       String
  org         LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  text        String
  sourceId    String?
  evidenceNote String?
  // proposed | approved | retired
  status      String   @default("proposed")
  approvedById String?
  approvedAt  DateTime?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([orgId, status])
}

// Access & asset checklist. Never stores passwords — access is granted through a
// connection (connectionId) or an invitation on the provider's side.
model CosChecklistItem {
  id           String        @id @default(cuid())
  orgId        String
  org          LosOrg        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagementId String
  engagement   CosEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  // access | asset | input
  kind         String
  key          String?
  label        String
  serviceSlug  String?
  provider     String?
  // pending | available | insufficient | disconnected | not_needed
  status       String        @default("pending")
  // client | catalyst
  ownerSide    String        @default("client")
  ownerId      String?
  dueAt        DateTime?
  note         String?
  connectionId String?
  assetId      String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  dependents   CosDependency[]

  @@unique([engagementId, key])
  @@index([orgId, status])
}

// workItem is blocked until the other work item is delivered OR the checklist item is available.
model CosDependency {
  id              String            @id @default(cuid())
  orgId           String
  org             LosOrg            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workItemId      String
  onWorkItemId    String?
  onChecklistId   String?
  onChecklist     CosChecklistItem? @relation(fields: [onChecklistId], references: [id], onDelete: Cascade)
  note            String?
  createdAt       DateTime          @default(now())

  @@unique([workItemId, onWorkItemId, onChecklistId])
  @@index([orgId, workItemId])
  @@index([onWorkItemId])
}

// MARKETING campaign (objective + brief). Distinct from LosCampaign (a lead-capture form),
// which points here through LosCampaign.marketingCampaignId.
model CosCampaign {
  id           String        @id @default(cuid())
  orgId        String
  org          LosOrg        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   CosEngagement? @relation(fields: [engagementId], references: [id])
  goalId       String?
  name         String
  // stable short code used in utm_campaign — never changes after creation
  code         String
  objective    String?
  audience     String?
  keyMessage   String?
  offer        String?
  cta          String?
  destinationUrl String?
  channels     String[]      @default([])
  // organic | paid | mixed
  paidMode     String        @default("organic")
  budgetNote   String?
  startsAt     DateTime?
  endsAt       DateTime?
  // draft | active | paused | completed | archived
  status       String        @default("draft")
  ownerId      String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  demo         Boolean       @default(false)

  @@unique([orgId, code])
  @@index([orgId, status])
}

// One channel adaptation of a master content work item. Own copy, media, approval,
// schedule and publication state.
model CosContentVariant {
  id            String      @id @default(cuid())
  orgId         String
  org           LosOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workItemId    String
  workItem      CosWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  // youtube | x | linkedin | facebook | instagram | blog
  channel       String
  // long_video | short | post | thread | article | carousel | reel
  format        String
  connectionId  String?
  title         String?
  body          String      @default("")
  // ordered parts: thread posts / carousel captions / video chapters (content, not relations)
  parts         String[]    @default([])
  cta           String?
  destinationUrl String?
  mediaAssetIds String[]    @default([])
  // draft | internal_qa | client_review | approved | scheduled | published | failed | needs_review | cancelled
  state         String      @default("draft")
  version       Int         @default(1)
  // sha256(title, body, parts, cta, destinationUrl, mediaAssetIds) — approvals bind to this
  contentHash   String
  // master version this variant was derived from; older ⇒ "source changed, review"
  sourceVersion Int         @default(1)
  sourceChanged Boolean     @default(false)
  clientReviewRequired Boolean @default(true)
  scheduledAt   DateTime?
  ownerId       String?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  demo          Boolean     @default(false)

  publications  CosPublication[]

  @@index([orgId, state])
  @@index([orgId, scheduledAt])
  @@index([workItemId])
}

// Persistent snapshot per material version (work item, variant, campaign brief).
model CosRevision {
  id          String   @id @default(cuid())
  orgId       String
  org         LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // work_item | variant | campaign
  subject     String
  subjectId   String
  version     Int
  contentHash String
  // JSON of the approvable fields at that version
  snapshot    String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([subject, subjectId, version])
  @@index([orgId, subject, subjectId])
}

model CosAsset {
  id             String   @id @default(cuid())
  orgId          String
  org            LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  // image | video | audio | document | other
  kind           String
  // brand | source | production | deliverable
  category       String   @default("production")
  tags           String[] @default([])
  // upload | ai_generated | external_link
  origin         String   @default("upload")
  rightsNote     String?
  sourceNote     String?
  // draft | approved | archived
  status         String   @default("draft")
  // client-visible? internal working files stay staff-only
  clientVisible  Boolean  @default(true)
  currentVersion Int      @default(1)
  workItemId     String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  demo           Boolean  @default(false)

  versions       CosAssetVersion[]

  @@index([orgId, status])
  @@index([orgId, category])
}

model CosAssetVersion {
  id          String   @id @default(cuid())
  orgId       String
  assetId     String
  asset       CosAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version     Int
  // storage adapter key — always prefixed with the orgId
  storageKey  String
  // local | vercel_blob | external
  storage     String
  mime        String
  sizeBytes   Int
  sha256      String
  width       Int?
  height      Int?
  durationSec Int?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([assetId, version])
}

// One intended publication of one variant to one account. idempotencyKey makes a
// second schedule/claim of the same variant version impossible.
model CosPublication {
  id             String            @id @default(cuid())
  orgId          String
  org            LosOrg            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  variantId      String
  variant        CosContentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  connectionId   String?
  channel        String
  // live | test (explicit test adapter — never counted as live verification) | manual
  adapter        String            @default("live")
  // scheduled | claimed | published | partial | failed | uncertain | cancelled
  status         String            @default("scheduled")
  scheduledAt    DateTime
  // IANA zone the user scheduled in (display only; scheduledAt is UTC)
  timezone       String            @default("UTC")
  variantVersion Int
  contentHash    String
  idempotencyKey String            @unique
  claimedAt      DateTime?
  publishedAt    DateTime?
  externalId     String?
  externalUrl    String?
  partsTotal     Int               @default(1)
  partsDone      Int               @default(0)
  // provider ids of parts already posted (thread) — a resume never re-posts them
  partExternalIds String[]         @default([])
  // JSON { [mediaIndex]: { id, at } }: provider-side ids of media ALREADY uploaded for this publication, so a retry
  // (LinkedIn still processing, X 429) reuses the original upload instead of uploading again. Dropped after 20 h.
  providerMedia   String?
  attemptCount   Int               @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  // manual publication evidence
  evidenceNote   String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attempts       CosPublishAttempt[]

  @@index([orgId, status])
  @@index([status, scheduledAt])
}

// APPEND-ONLY.
model CosPublishAttempt {
  id            String         @id @default(cuid())
  orgId         String
  publicationId String
  publication   CosPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  n             Int
  // success | partial | retryable_failure | definite_failure | uncertain | blocked
  outcome       String
  httpStatus    Int?
  error         String?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?

  @@index([publicationId, n])
}

// Dimensional metrics. dimKey = "org" | "acct:<connectionId>" | "pub:<publicationId>" |
// "camp:<campaignId>" | "url:<sha1>" so the unique key works without nullable columns.
model CosMetricSnapshot {
  id            String   @id @default(cuid())
  orgId         String
  org           LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider      String
  metric        String
  // daily (an increment for that day — summable) | lifetime (a running total — take the latest, never sum)
  kind          String
  dimKey        String   @default("org")
  connectionId  String?
  publicationId String?
  campaignId    String?
  url           String?
  // daily: the day (UTC midnight). lifetime: the observation time truncated to the day.
  periodStart   DateTime
  value         Float
  currency      String?
  // api | manual | import
  source        String   @default("api")
  // organic | paid | unknown
  paidMode      String   @default("unknown")
  grade         String?
  syncedAt      DateTime @default(now())
  enteredById   String?
  demo          Boolean  @default(false)

  @@unique([orgId, provider, metric, kind, dimKey, periodStart])
  @@index([orgId, publicationId])
  @@index([orgId, campaignId])
}

// Sales opportunity on a lead. status=won + valueMinor + currency + closeDate = a recorded sale.
model CosOpportunity {
  id           String   @id @default(cuid())
  orgId        String
  org          LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId       String?
  engagementId String?
  campaignId   String?
  variantId    String?
  title        String
  // open | qualified | proposal | won | lost
  status       String   @default("open")
  valueMinor   BigInt?
  currency     String?
  closeDate    DateTime?
  lostReason   String?
  // copied from the lead at creation so later lead edits cannot rewrite history
  attributionKind String @default("unknown")
  attributionNote String?
  ownerId      String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  demo         Boolean  @default(false)

  @@index([orgId, status])
  @@index([orgId, campaignId])
  @@index([leadId])
}

// One recurring delivery period. The unique key is what makes generation idempotent.
model CosCycle {
  id           String        @id @default(cuid())
  orgId        String
  org          LosOrg        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagementId String
  engagement   CosEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  // open | closed | skipped (paused)
  status       String        @default("open")
  itemsCreated Int           @default(0)
  createdAt    DateTime      @default(now())

  @@unique([engagementId, periodStart])
}

// A fee the client owes: setup, recurring period, approved change. Invoices may live elsewhere
// (managedExternally) — then only the reference and the status someone recorded are kept.
model CosCommercialRecord {
  id           String        @id @default(cuid())
  orgId        String
  org          LosOrg        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagementId String
  engagement   CosEngagement @relation(fields: [engagementId], references: [id])
  // setup | recurring | change | other
  kind         String
  description  String
  amountMinor  BigInt
  currency     String
  // draft | issued | part_paid | paid | overdue | void | refunded
  status       String        @default("draft")
  managedExternally Boolean  @default(true)
  invoiceRef   String?
  invoiceUrl   String?
  dueAt        DateTime?
  workItemId   String?
  cycleId      String?
  paidMinor    BigInt        @default(0)
  // how "paid" was established: webhook (verified) | recorded (a person entered it)
  paidBasis    String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  demo         Boolean       @default(false)

  payments     CosPaymentEvent[]

  // one record per change request / per cycle — generation can never double-charge
  @@unique([engagementId, kind, workItemId])
  @@unique([engagementId, kind, cycleId])
  @@index([orgId, status])
}

// APPEND-ONLY. providerEventId unique ⇒ a replayed webhook is a no-op.
model CosPaymentEvent {
  id              String               @id @default(cuid())
  orgId           String?
  org             LosOrg?              @relation(fields: [orgId], references: [id], onDelete: SetNull)
  recordId        String?
  record          CosCommercialRecord? @relation(fields: [recordId], references: [id])
  // stripe | manual
  provider        String
  providerEventId String               @unique
  type            String
  amountMinor     BigInt?
  currency        String?
  // true only when the provider's signature was verified
  verified        Boolean              @default(false)
  // token_pack | subscription | deposit | commercial_record | ai_credits | ai_credits_reversal | record_refund | unmatched
  appliedTo       String               @default("unmatched")
  // provider payment id (Stripe payment_intent): ties refund / dispute events to the original payment
  providerPaymentId String?
  creditOrderId   String?
  note            String?
  createdAt       DateTime             @default(now())

  @@index([orgId, createdAt])
  @@index([providerPaymentId])
}

// APPEND-ONLY. costMicros NULL = price not configured (unknown), never 0.
model CosAiUsage {
  id           String   @id @default(cuid())
  orgId        String
  org          LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  feature      String
  // text | image | video
  modality     String   @default("text")
  model        String
  inputTokens  Int?
  outputTokens Int?
  units        Int?
  costMicros   Int?
  ok           Boolean  @default(true)
  workItemId   String?
  userId       String?
  createdAt    DateTime @default(now())
  demo         Boolean  @default(false)
  // WHO PAYS. orgId is only who the output is FOR. Historical rows default to internal, so
  // nothing recorded before the wallet existed can ever become a client debit.
  // catalyst_internal | client_wallet
  payer          String  @default("catalyst_internal")
  // internal_delivery | client_self_service | staff_assisted_client_billed | system
  billingPurpose String  @default("internal_delivery")
  operationId    String?

  @@index([orgId, createdAt])
  @@index([operationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI CREDITS. Integer units. NOT lead tokens (LosTokenLedger) and never convertible to them.
// Invariant (lib/os/credits.ts walletInvariant):
//   sum(CosCreditLedger.delta) = sum(CosCreditGrant.remaining) + sum(active reservation amount) - wallet.deficit
//   available = sum(remaining of unexpired grants); every mutation runs under a row lock on the wallet.
// ─────────────────────────────────────────────────────────────────────────────

model CosCreditWallet {
  orgId        String   @id
  org          LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // credits consumed and later clawed back by a refund / lost dispute. While > 0 metered AI is blocked;
  // the next grant pays it down first. Nothing is ever charged to a card automatically.
  deficit      Int      @default(0)
  // low-balance notice threshold (credits); null = no notice
  lowBalanceAt Int?
  // emailed low-balance notice to billing members: opt-out, one per episode. `lowArmed` flips off when a notice goes out and
  // back on when the balance recovers above the threshold or the threshold changes; `lowNotifiedAt` enforces the cooldown.
  lowBalanceEmail Boolean @default(true)
  lowArmed        Boolean @default(true)
  lowNotifiedAt   DateTime?
  // paid auto-recharge is NOT implemented in this release; the flag exists so "off" is explicit
  autoRecharge Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Provenance of every credit. `remaining` only goes down, except when an unused reservation returns.
model CosCreditGrant {
  id        String    @id @default(cuid())
  orgId     String
  org       LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // purchased | included | promotional | adjustment
  kind      String
  amount    Int
  remaining Int
  // purchased credits: null (do not expire) unless commercially configured; included/promotional: explicit
  expiresAt DateTime?
  // unique provenance, so granting is idempotent: order:<id> | contract:<id> | admin:<uuid> | dispute_won:<orderId>
  sourceRef String    @unique
  reason    String
  createdBy String?
  createdAt DateTime  @default(now())
  demo      Boolean   @default(false)

  @@index([orgId, expiresAt])
}

// APPEND-ONLY. Corrections are compensating entries; rows are never updated or deleted.
model CosCreditLedger {
  id          String   @id @default(cuid())
  orgId       String
  org         LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // grant | debit | expire | reversal | adjustment | deficit_recovery
  kind        String
  delta       Int
  reason      String
  // source references: what caused it
  grantId     String?
  operationId String?
  orderId     String?
  actorId     String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([operationId])
}

// One per logical AI operation (operationId unique): a request reserves and settles at most once.
model CosCreditReservation {
  id             String    @id @default(cuid())
  orgId          String
  org            LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  operationId    String    @unique
  userId         String
  amount         Int
  // JSON [{grantId, amount}]: which grants the hold was taken from (returned on release)
  allocations    String
  // active | settled | released
  status         String    @default("active")
  settledCredits Int?
  releaseReason  String?
  createdAt      DateTime  @default(now())
  closedAt       DateTime?

  @@index([orgId, status])
  @@index([orgId, userId, createdAt])
}

// Versioned prices in credits. At most one row is `active`; quotes pin the version they were made under.
model CosCreditRateCard {
  id          String    @id @default(cuid())
  version     Int       @unique
  // draft | active | retired
  status      String    @default("draft")
  // JSON { [toolKey]: { base: int, perKOutputTokens: int } }
  rates       String
  note        String?
  // true = synthetic values for dev/test; refused in production
  synthetic   Boolean   @default(false)
  createdBy   String?
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
}

model CosCreditQuote {
  id              String    @id @default(cuid())
  orgId           String
  org             LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId          String
  toolKey         String
  // sha256 of the canonical inputs: executing with different inputs is refused
  inputHash       String
  model           String
  maxOutputTokens Int
  rateCardId      String
  rateVersion     Int
  maxCredits      Int
  payer           String
  billingPurpose  String
  billingAuthId   String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([orgId, userId, createdAt])
}

// The logical AI request. requestId is the caller's idempotency key (double submit = same operation).
model CosAiOperation {
  id             String    @id @default(cuid())
  orgId          String
  org            LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestId      String
  quoteId        String    @unique
  // who started it
  userId         String
  toolKey        String
  // JSON, the tool's own fields; never lead personal data
  inputs         String
  inputHash      String
  model          String
  maxOutputTokens Int
  payer          String
  billingPurpose String
  billingAuthId  String?
  // queued | running | completed | failed | uncertain | cancelled
  status         String    @default("queued")
  maxCredits     Int
  chargedCredits Int       @default(0)
  // JSON tool output (a DRAFT). Null until completed.
  output         String?
  // deterministic validator results shown to the editor
  flags          String    @default("[]")
  error          String?
  // JSON [{kind: variant|work|asset|campaign, id}]: where the draft was saved
  savedTo        String    @default("[]")
  engagementId   String?
  campaignId     String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  demo           Boolean   @default(false)
  attempts       CosAiAttempt[]

  @@unique([orgId, requestId])
  @@index([orgId, createdAt])
  @@index([status, startedAt])
}

// A `started` row with no end = the worker died around the provider call (reconciled, never blindly retried).
model CosAiAttempt {
  id           String         @id @default(cuid())
  operationId  String
  operation    CosAiOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  n            Int
  // started | ok | failed | uncertain (uncertain = the provider may have done the work: worker lost, or our timeout)
  status       String         @default("started")
  model        String
  // the provider's own id for the (last) answered request, when it gave one — for matching a provider invoice line
  providerRequestId String?
  inputTokens  Int?
  outputTokens Int?
  // provider money cost in micro-USD; NULL = unknown (never 0)
  costMicros   Int?
  error        String?
  startedAt    DateTime       @default(now())
  endedAt      DateTime?

  @@unique([operationId, n])
}

// A client billing user lets Catalyst staff spend from the client's wallet, up to a ceiling, until a date.
// Without a live row, staff usage is ALWAYS catalyst_internal.
model CosAiBillingAuth {
  id          String    @id @default(cuid())
  orgId       String
  org         LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grantedById String
  maxCredits  Int
  usedCredits Int       @default(0)
  note        String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, expiresAt])
}

// Caps restrict a SHARED wallet per member per calendar month (workspace zone). They create no credits.
model CosCreditMemberLimit {
  orgId          String
  org            LosOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId         String
  monthlyCredits Int
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  @@id([orgId, userId])
}

// Operator-configured packs. No pack exists until someone enters real commercial values.
model CosCreditPack {
  id          String   @id @default(cuid())
  label       String
  credits     Int
  currency    String
  amountMinor Int
  // IN | US | null (any)
  market      String?
  active      Boolean  @default(false)
  // synthetic = dev/test values, never purchasable in production
  synthetic   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
}

// A tenant-linked purchase. Credits are granted ONLY from a verified provider event, never from a redirect.
model CosCreditOrder {
  id                String    @id @default(cuid())
  orgId             String
  org               LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId            String
  packId            String
  // snapshot of the pack at order time; later pack edits never change an order
  credits           Int
  currency          String
  amountMinor       Int
  // pending | paid | failed | expired | refunded | part_refunded | disputed
  status            String    @default("pending")
  // live | test: must match the event's livemode
  providerMode      String
  providerSessionId String?   @unique
  providerPaymentId String?   @unique
  // cumulative, straight from the provider: refund handling is order-independent and idempotent
  refundedMinor     Int       @default(0)
  // open | won | lost
  disputeStatus     String?
  reversedCredits   Int       @default(0)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  demo              Boolean   @default(false)

  @@index([orgId, createdAt])
}

model CosNotification {
  id        String    @id @default(cuid())
  orgId     String
  org       LosOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // a person, or an audience when userId is null: client | staff
  userId    String?
  audience  String    @default("staff")
  // approval_requested | revision_requested | blocked | publish_failed | publish_uncertain |
  // connection_failed | renewal_due | access_needed | payment | cycle_generated
  kind      String
  title     String
  body      String?
  href      String?
  // same key ⇒ same notification (no duplicates from retries / re-ticks)
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId, audience, readAt])
  @@index([userId, readAt])
}

// Scheduler heartbeat — lets the operator console say "scheduler last ran N min ago".
model CosHeartbeat {
  key   String   @id
  at    DateTime
  note  String?
}

// ── First-party build 2026-09-27 (docs/os/integrations-plan.md v2) ───────────

// WP-03 · request errors captured by instrumentation.onRequestError, one row per fingerprint. Never holds a request
// body or personal data: message + truncated stack + route only.
model CosErrorEvent {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  message     String
  stack       String?
  route       String?
  orgId       String?
  count       Int      @default(1)
  firstAt     DateTime @default(now())
  lastAt      DateTime @default(now())
  resolvedAt  DateTime?

  @@index([lastAt])
}

// WP-06 · feature flags read by gateAction: an org row overrides the global row (orgId = ""). Kill switch stays separate.
model CosFeatureFlag {
  id        String   @id @default(cuid())
  key       String
  // "" = global
  orgId     String   @default("")
  on        Boolean  @default(false)
  note      String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([key, orgId])
}

// WP-07 · per-user notification preferences per kind; absent row = in-app only.
model CosNotificationPref {
  id      String  @id @default(cuid())
  userId  String
  orgId   String
  kind    String
  inApp   Boolean @default(true)
  email   Boolean @default(false)
  slack   Boolean @default(false)

  @@unique([userId, orgId, kind])
}

// WP-05 · short-link clicks. No IP, no user-agent string: referrer host and a coarse UA class only.
model LosLinkClick {
  id        String   @id @default(cuid())
  linkId    String
  at        DateTime @default(now())
  refDomain String?
  // bot | mobile | desktop | unknown
  uaClass   String   @default("unknown")

  @@index([linkId, at])
}

// WP-05 · short links for published content (/l/:code → tagged destination). One per variant, stable code.
model CosShortLink {
  id        String   @id @default(cuid())
  orgId     String
  code      String   @unique
  url       String
  variantId String?  @unique
  label     String?
  createdAt DateTime @default(now())

  @@index([orgId])
}

// WP-14 · Search Console query × page rows (28-day window, one snapshot per sync day). Impressions, clicks and position
// are real first-party numbers; search VOLUME is never stored or shown.
model CosSearchQuery {
  id          String   @id @default(cuid())
  orgId       String
  day         DateTime
  query       String
  page        String
  impressions Int
  clicks      Int
  position    Float

  @@unique([orgId, day, query, page])
  @@index([orgId, day])
}

// WP-15 · contact verification before the first send. Keyed by the contact hash (never the address); 90-day TTL.
// ponytail: no mailbox-level probe — Vercel has no outbound port 25; syntax + MX + disposable list + role detection only.
model LosContactCheck {
  id          String   @id @default(cuid())
  contactHash String   @unique
  // email | phone
  kind        String
  // ok | risky | invalid
  verdict     String
  reason      String?
  provider    String
  checkedAt   DateTime @default(now())

  @@index([checkedAt])
}

// WP-16 · booking pages. One host per type (team round-robin out of scope). A slot is claimed by the unique slotKey
// (`hostId:startAtISO`) on the live booking; cancelling clears it so the slot frees without deleting the record.
model CosBookingType {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  durationMin Int      @default(30)
  bufferMin   Int      @default(10)
  hostId      String
  // JSON [{key,label,required}]
  questions   String   @default("[]")
  // draft | active | paused
  status      String   @default("draft")
  // IANA zone the availability rows are written in
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  demo        Boolean  @default(false)

  @@index([orgId, status])
}

model CosAvailability {
  id      String @id @default(cuid())
  orgId   String
  userId  String
  // 0 = Sunday … 6 = Saturday
  weekday Int
  // HH:MM in the booking type's zone
  start   String
  end     String

  @@index([orgId, userId])
}

model CosBooking {
  id              String    @id @default(cuid())
  orgId           String
  typeId          String
  hostId          String
  startAt         DateTime
  endAt           DateTime
  // hostId:startAt while confirmed; null once cancelled (frees the slot)
  slotKey         String?   @unique
  // client-generated idempotency key
  requestId       String?   @unique
  leadId          String?
  name            String
  email           String
  phone           String?
  answers         String?
  // confirmed | cancelled
  status          String    @default("confirmed")
  // sha256 of the manage token in the confirmation email
  tokenHash       String    @unique
  calendarEventId String?
  visitorTz       String?
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?
  demo            Boolean   @default(false)

  @@index([orgId, startAt])
  @@index([hostId, startAt])
}

// WP-21 · brand-voice rules per workspace, evaluated deterministically in copy checks (reading grade is a syllable
// heuristic and labelled as such). `color` also feeds the WP-22 graphic templates.
model CosBrandRules {
  orgId           String   @id
  bannedPhrases   String[] @default([])
  requiredPhrases String[] @default([])
  maxReadingGrade Int?
  toneNotes       String?
  // #rrggbb used by the graphic templates
  color           String?
  updatedById     String?
  updatedAt       DateTime @updatedAt
}

// WP-24 · tracked search phrases (positions read from Search Console rows weekly; never scraped).
model CosTrackedKeyword {
  id          String   @id @default(cuid())
  orgId       String
  query       String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([orgId, query])
}
